# Langtrain shared editor settings (same file in every repo).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,rs,toml,swift,kt,java,c,cpp,h,cu}]
indent_size = 4

[{Makefile,*.mk,*.go}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
